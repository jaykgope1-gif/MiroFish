# ===== Claude (Anthropic) =====
# Set LLM_PROVIDER=anthropic to run everything on Claude through the
# Anthropic SDK. Get a key at https://platform.claude.com (Settings > API keys).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model per job (defaults shown):
#   report:     ontology, report agent, graph search  -> Sonnet
#   fast:       agent profiles, simulation config     -> Haiku
#   simulation: every OASIS agent action/interview    -> Haiku
# CLAUDE_REPORT_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_SIMULATION_MODEL=claude-haiku-5-5
# CLAUDE_REPORT_EFFORT=high
# CLAUDE_FAST_EFFORT=low
# CLAUDE_SIMULATION_EFFORT=low
# CLAUDE_SIMULATION_THINKING=disabled
# History tokens each agent sees per call; the main cost lever of a run.
# CLAUDE_SIMULATION_CONTEXT_TOKENS=24000

# Cost control (rand). A simulation stops early once preparation +
# simulation reach RUN_BUDGET_ZAR - REPORT_RESERVE_ZAR. Set today's rate.
RUN_BUDGET_ZAR=50
REPORT_RESERVE_ZAR=12
USD_ZAR_RATE=18.5

# ===== OpenAI-compatible provider (LLM_PROVIDER=openai) =====
# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
